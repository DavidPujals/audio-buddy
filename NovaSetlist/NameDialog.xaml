<Window x:Class="NovaSetlist.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setlist name"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="18,16">
        <TextBlock x:Name="PromptText" Text="NAME" Style="{StaticResource SectionHeader}" Margin="1,0,0,6" />
        <TextBox x:Name="NameBox" MinHeight="30" />
        <TextBlock x:Name="HintText" Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="2,4,0,0"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" MinWidth="76" IsCancel="True" />
            <Button x:Name="OkButton" Content="OK" MinWidth="76" Margin="6,0,0,0" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
